{
  "name": "@nonsuch/component-library",
  "version": "0.30.1",
  "description": "A Vue 3 component library built on Quasar with opinionated defaults and custom components.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "engines": {
    "node": ">=22.22.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nonsuch-io/componentLibrary.git"
  },
  "files": [
    "dist",
    "fonts",
    "src/tokens/tokens.css",
    "src/tokens/typography.css"
  ],
  "main": "./dist/nonsuch-components.js",
  "module": "./dist/nonsuch-components.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nonsuch-components.js"
    },
    "./quasar-config": {
      "types": "./dist/quasarConfig.d.ts",
      "import": "./dist/quasar-config.js"
    },
    "./style.css": "./dist/nonsuch-components.css",
    "./fonts.css": "./fonts/fonts.css",
    "./fonts/global.css": "./fonts/global.css",
    "./fonts/quasar-overrides": "./fonts/_quasar-overrides.sass",
    "./tokens.css": "./src/tokens/tokens.css",
    "./typography.css": "./src/tokens/typography.css"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "vite build && rm -f tsconfig.build.tsbuildinfo && vue-tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build:watch": "vite build --watch",
    "build:storybook": "storybook build",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:storybook": "vitest run --project storybook",
    "preview": "vite preview",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepare": "husky",
    "size": "size-limit",
    "size:check": "size-limit --limit"
  },
  "size-limit": [
    {
      "name": "full library (gzip)",
      "path": "dist/nonsuch-components.js",
      "import": "*",
      "limit": "24 kB",
      "gzip": true,
      "ignore": [
        "vue",
        "quasar",
        "@phosphor-icons/vue"
      ]
    },
    {
      "name": "single component: NsButton (tree-shaking guard)",
      "path": "dist/nonsuch-components.js",
      "import": "{ NsButton }",
      "limit": "3 kB",
      "gzip": true,
      "ignore": [
        "vue",
        "quasar",
        "@phosphor-icons/vue"
      ]
    },
    {
      "name": "app shell (heaviest import; contains NsInput, so NsInput changes land here)",
      "path": "dist/nonsuch-components.js",
      "import": "{ NsAppShell }",
      "limit": "10.5 kB",
      "gzip": true,
      "ignore": [
        "vue",
        "quasar",
        "@phosphor-icons/vue"
      ]
    },
    {
      "name": "styles",
      "path": "dist/nonsuch-components.css",
      "limit": "6 kB",
      "gzip": true
    }
  ],
  "dependencies": {
    "@phosphor-icons/vue": "^2.2.1"
  },
  "peerDependencies": {
    "@quasar/vite-plugin": "^1.8.0",
    "quasar": "^2.17.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@quasar/vite-plugin": {
      "optional": true
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "@quasar/extras": "^2.0.0",
    "@quasar/vite-plugin": "^1.10.0",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@storybook/addon-a11y": "^10.2.19",
    "@storybook/addon-docs": "^10.2.19",
    "@storybook/addon-vitest": "^10.2.19",
    "@storybook/vue3-vite": "^10.2.19",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "^4.1.5",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.7.0",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "happy-dom": "^20.5.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "playwright": "^1.58.2",
    "postcss-rtlcss": "^6.0.0",
    "prettier": "^3.8.1",
    "quasar": "^2.18.6",
    "sass-embedded": "^1.97.3",
    "size-limit": "^12.0.1",
    "storybook": "^10.2.19",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.54.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.5",
    "vue": "^3.5.27",
    "vue-tsc": "^3.2.4"
  },
  "packageManager": "pnpm@10.32.1",
  "lint-staged": {
    "*.{ts,vue}": "eslint --fix",
    "*.{ts,vue,json,md,css,scss,sass,html,yaml,yml}": "prettier --write"
  }
}
