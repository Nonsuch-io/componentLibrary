{
  "name": "@nonsuch/component-library",
  "version": "0.34.1",
  "description": "A Vue 3 component library built on Quasar with opinionated defaults and custom components.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "engines": {
    "node": ">=22.22.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nonsuch-io/componentLibrary.git"
  },
  "files": [
    "dist",
    "fonts",
    "src/tokens/tokens.css",
    "src/tokens/typography.css"
  ],
  "main": "./dist/nonsuch-components.js",
  "module": "./dist/nonsuch-components.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nonsuch-components.js"
    },
    "./quasar-config": {
      "types": "./dist/quasarConfig.d.ts",
      "import": "./dist/quasar-config.js"
    },
    "./style.css": "./dist/nonsuch-components.css",
    "./fonts.css": "./fonts/fonts.css",
    "./fonts/global.css": "./fonts/global.css",
    "./fonts/quasar-overrides": "./fonts/_quasar-overrides.sass",
    "./tokens.css": "./src/tokens/tokens.css",
    "./typography.css": "./src/tokens/typography.css",
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    }
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "vite build && rm -f tsconfig.build.tsbuildinfo && vue-tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build:watch": "vite build --watch",
    "build:storybook": "storybook build",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit && vue-tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:storybook": "vitest run --project storybook",
    "preview": "vite preview",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepare": "husky",
    "size": "size-limit",
    "size:check": "size-limit --limit"
  },
  "size-limit": [
    {
      "name": "full library (gzip) — a SOFT ceiling, raised to 25.5 kB on 2026-09-08 to cover roughly the next three components of epic componentLibrary-lrw at the observed ~400-640 B each, rather than stopping to bump it every time. DELIBERATELY NOT AN EPIC-END FIGURE: ~12 builds remain (fewer than the bead count — several are NsCard compositions — but more were found nested), which would need ~5 kB of headroom and would stop catching anything at all. At 25.5 a single component adding more than ~1 kB still trips this, which is the case worth stopping for. RE-SET IT at 25.5 rather than drifting past it. The dev warnings are 3,032 B gzip of this, measured 2026-09-08 by short-circuiting all 15 guard sites and rebuilding; they are a tested contract (useNsDisabled.dist.test.ts) and the only mechanism that reclaims them is dual conditional exports — see the conditional-exports bead. This ceiling comes back DOWN when that lands",
      "path": "dist/nonsuch-components.js",
      "import": "*",
      "limit": "25.5 kB",
      "gzip": true,
      "ignore": [
        "vue",
        "quasar",
        "@phosphor-icons/vue"
      ]
    },
    {
      "name": "single component: NsButton (tree-shaking guard)",
      "path": "dist/nonsuch-components.js",
      "import": "{ NsButton }",
      "limit": "2.75 kB",
      "gzip": true,
      "ignore": [
        "vue",
        "quasar",
        "@phosphor-icons/vue"
      ]
    },
    {
      "name": "single component: NsBrandLogo (must not pull more than NsImage, which is 1.38 kB)",
      "path": "dist/nonsuch-components.js",
      "import": "{ NsBrandLogo }",
      "limit": "2.25 kB",
      "gzip": true,
      "ignore": [
        "vue",
        "quasar",
        "@phosphor-icons/vue"
      ]
    },
    {
      "name": "app shell (heaviest import; contains NsInput and NsNavSidebar. Includes the en-CA locale object — a ONE-TIME 440 B for the first useNsLocale() consumer in this chunk, ~0 for the next)",
      "path": "dist/nonsuch-components.js",
      "import": "{ NsAppShell }",
      "limit": "10.75 kB",
      "gzip": true,
      "ignore": [
        "vue",
        "quasar",
        "@phosphor-icons/vue"
      ]
    },
    {
      "name": "manifest subpath (build tooling; must never pull runtime code)",
      "path": "dist/manifest.js",
      "limit": "0.75 kB",
      "gzip": true
    },
    {
      "name": "styles (gzip) — ALSO A SOFT CEILING. Raised to 6.25 kB for the type ramp: typography.css is now imported by src/index.ts, so the 21 type classes ship with the components instead of sitting in an optional file no consumer imported. Reclaim available in componentLibrary-cqy",
      "path": "dist/nonsuch-components.css",
      "limit": "6.25 kB",
      "gzip": true
    }
  ],
  "dependencies": {
    "@phosphor-icons/vue": "^2.2.1"
  },
  "peerDependencies": {
    "quasar": "^2.17.0",
    "vue": "^3.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "@quasar/extras": "^2.0.0",
    "@quasar/vite-plugin": "^2.0.0",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@storybook/addon-a11y": "^10.2.19",
    "@storybook/addon-docs": "^10.2.19",
    "@storybook/addon-vitest": "^10.2.19",
    "@storybook/vue3-vite": "^10.2.19",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "^4.1.5",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.7.0",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "happy-dom": "^20.5.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "playwright": "^1.58.2",
    "postcss-rtlcss": "^6.0.0",
    "prettier": "^3.8.1",
    "quasar": "^2.18.6",
    "sass-embedded": "^1.97.3",
    "size-limit": "^12.0.1",
    "storybook": "^10.2.19",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.54.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.5",
    "vue": "^3.5.27",
    "vue-tsc": "^3.2.4"
  },
  "packageManager": "pnpm@10.32.1",
  "lint-staged": {
    "*.{ts,vue}": "eslint --fix",
    "*.{ts,vue,json,md,css,scss,sass,html,yaml,yml}": "prettier --write"
  }
}
